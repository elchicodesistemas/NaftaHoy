# Postgres — connection string completo (local o Neon)
DATABASE_URL=postgresql://usuario:password@localhost:5432/naftahoy_dev

# Firma los JWT que devuelve POST /auth/token. Generarla con:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=

# Vida del access token. Formato de "ms" (ej: "1h", "15m", "7d").
JWT_EXPIRES_IN=1h
