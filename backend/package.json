{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API y workers de ingesta de precios de NaftaHoy",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:estaciones": "tsx src/workers/importarSurtidorEnergia.ts",
    "db:generate:integradores": "drizzle-kit generate --config=drizzle-integradores.config.ts",
    "db:migrate:integradores": "drizzle-kit migrate --config=drizzle-integradores.config.ts",
    "seed:integrador": "tsx src/scripts/seedIntegrador.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "hono-rate-limiter": "^0.5.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
