datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Station {
  id          String        @id @default(uuid())
  govId       Int?          @unique
  cuit        String?
  name        String
  address     String
  city        String
  province    String
  region      String?
  brand       String        // Normalizado: ypf, shell, axion, puma, dapsa, gulf, blanca, etc.
  brandName   String        // Nombre visible: YPF, Shell, Axion Energy, Puma Energy, etc.
  brandId     Int?
  lat         Float?
  lng         Float?
  prices      PriceRecord[]
  ratings     StationRating[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([province])
  @@index([brand])
  @@index([lat, lng])
}

model PriceRecord {
  id              Int      @id @default(autoincrement())
  stationId       String
  station         Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  fuelType        String   // SUPER, PREMIUM, DIESEL, DIESEL_PREMIUM, GNC
  fuelTypeName    String   // Nafta Súper, Nafta Premium, Diesel, Diesel Premium, GNC
  originalProduct String
  timeSlot        String   // Diurno, Nocturno
  price           Float
  prevPrice       Float?
  effectiveDate   DateTime
  updatedAt       DateTime @updatedAt

  @@unique([stationId, fuelType, timeSlot, effectiveDate])
  @@index([stationId, fuelType, timeSlot, effectiveDate])
  @@index([fuelType])
  @@index([price])
}

model SyncLog {
  id               Int       @id @default(autoincrement())
  source           String
  status           String    // SUCCESS, FAILED, RUNNING
  recordsProcessed Int       @default(0)
  stationsCount    Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

model CommunityReport {
  id          Int      @id @default(autoincrement())
  userName    String
  province    String
  city        String
  stationName String
  brand       String
  fuelType    String
  price       Float
  likes       Int      @default(0)
  status      String   @default("PENDING")
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model FuelQualityVote {
  id        Int      @id @default(autoincrement())
  visitorId String   @unique
  brand     String
  createdAt DateTime @default(now())

  @@index([brand])
  @@index([createdAt])
}

model StationRating {
  id             Int      @id @default(autoincrement())
  stationId      String
  station        Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  visitorId      String
  fuelQuality    Int
  service        Int
  cleanliness    Int
  speed          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([stationId, visitorId])
  @@index([stationId, createdAt])
}

model Advertiser {
  id        String     @id @default(uuid())
  name      String
  contact   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  campaigns Campaign[]

  @@index([active])
}

model Campaign {
  id           String     @id @default(uuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name         String
  startsAt     DateTime
  endsAt       DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  ads          Ad[]

  @@index([advertiserId])
  @@index([active, startsAt, endsAt])
}

model Ad {
  id             String         @id @default(uuid())
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name           String
  imageUrl       String?
  destinationUrl String
  placement      String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  impressions    AdImpression[]
  clicks         AdClick[]

  @@index([campaignId])
  @@index([placement, active])
}

model AdImpression {
  id        Int      @id @default(autoincrement())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  pagePath  String
  placement String
  visitorId String?
  createdAt DateTime @default(now())

  @@index([adId, createdAt])
  @@index([placement, createdAt])
}

model AdClick {
  id        Int      @id @default(autoincrement())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  pagePath  String
  placement String
  visitorId String?
  createdAt DateTime @default(now())

  @@index([adId, createdAt])
  @@index([placement, createdAt])
}
