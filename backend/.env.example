PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://naftahoy:naftahoy@localhost:5432/naftahoy?schema=public"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
SYNC_API_TOKEN="replace-with-a-long-random-secret"
ADMIN_API_TOKEN="replace-with-a-different-long-random-secret"
REPORT_RATE_LIMIT_PER_HOUR="5"
# Secreto exclusivo del servidor para la cookie HttpOnly de votación.
VOTE_TOKEN_SECRET="replace-with-another-long-random-secret"
VOTE_COOKIE_NAME="naftahoy_vote"
VOTE_COOKIE_PATH="/"
VOTE_RATE_LIMIT_PER_HOUR="12"

# Fuente oficial vigente: sistema RES 1104/2004. Publica información mensual.
RES1104_ZIP_URL="http://res1104.se.gob.ar/adjuntos/precios_eess_2025_en_adelante.zip"
RES1104_TABLE_NAME="public_vi_access_eess_2025_en_adelante"

# La carga se realiza manualmente desde el VPS; dejar vacío desactiva el cron.
CRON_SYNC_SCHEDULE=""
MANUAL_IMPORT_MAX_BYTES="2147483648"
